<?xml version="1.0"?>
<ruleset name="MagentoBricklayer">
    <description>PSR-12 with project-specific adjustments.</description>

    <file>src</file>
    <file>tests</file>

    <arg name="colors"/>
    <arg value="p"/>

    <!-- Strict gate: warnings fail the build too. Heredoc/nowdoc bodies that cannot
         wrap without changing string content carry scoped phpcs:disable guards. -->
    <rule ref="PSR12"/>

    <!-- Descriptive test method names are exempt from the camelCase sniff. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- Namespace-level function overrides and conditional stub loading are deliberate in tests. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
