includes:
    - phpstan-baseline.neon

parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - vendor (?)
        - tests/Stubs
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Successors of the pre-2.x checkMissingIterableValueType /
        # checkGenericClassInNonGenericObjectType boolean switches
        - identifier: missingType.iterableValue
        - identifier: missingType.generics
        # Magento classes may not be available during static analysis
        - '#Class Magento\\[a-zA-Z0-9\\]+ not found#'
        - '#Interface Magento\\[a-zA-Z0-9\\]+ not found#'
