includes:
    - phpstan-baseline.neon

parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - vendor
        - tests/Stubs
    checkMissingIterableValueType: false
    checkGenericClassInNonGenericObjectType: false
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Magento classes may not be available during static analysis
        - '#Class Magento\\[a-zA-Z0-9\\]+ not found#'
        - '#Interface Magento\\[a-zA-Z0-9\\]+ not found#'
