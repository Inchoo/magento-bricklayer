#!/usr/bin/env php
<?php
/**
 * Copyright (c) Inchoo. All rights reserved.
 * See LICENSE.txt for license details.
 *
 * Magento Bricklayer CLI Entry Point
 *
 * This is the main CLI application for Magento Bricklayer, built on Symfony Console.
 * It provides commands for installation, inspection, and MCP server management.
 */

declare(strict_types=1);

// Prevent direct web access
if (PHP_SAPI !== 'cli' && PHP_SAPI !== 'phpdbg') {
    echo 'This script must be run from the command line.' . PHP_EOL;
    exit(1);
}

// Find and load Composer autoloader
$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',      // Development (running from package root)
    __DIR__ . '/../../../autoload.php',        // Installed as dependency (vendor/inchoo/magento-bricklayer/bin)
    __DIR__ . '/../../../../vendor/autoload.php', // Alternative path
];

$autoloader = null;
foreach ($autoloadPaths as $path) {
    if (file_exists($path)) {
        $autoloader = require $path;
        break;
    }
}

if ($autoloader === null) {
    fwrite(STDERR, <<<ERROR
Composer autoloader not found.

Please run 'composer install' to install dependencies.

Searched paths:
ERROR
    );
    foreach ($autoloadPaths as $path) {
        fwrite(STDERR, "  - $path\n");
    }
    exit(1);
}

// Set error reporting for development
error_reporting(E_ALL);
ini_set('display_errors', '0');

// Handle signals for graceful shutdown
if (extension_loaded('pcntl')) {
    pcntl_async_signals(true);
    pcntl_signal(SIGINT, function () {
        exit(130);
    });
    pcntl_signal(SIGTERM, function () {
        exit(143);
    });
}

// Run the application
try {
    $application = new \Inchoo\MagentoBricklayer\Application();
    $exitCode = $application->run();
    exit($exitCode);
} catch (\Throwable $e) {
    fwrite(STDERR, "Error: " . $e->getMessage() . "\n");
    if (getenv('BRICKLAYER_DEBUG')) {
        fwrite(STDERR, "\n" . $e->getTraceAsString() . "\n");
    }
    exit(1);
}
