#!/usr/bin/env php
<?php
/**
 * Copyright (c) Inchoo. All rights reserved.
 * See LICENSE.txt for license details.
 *
 * Magento Bricklayer MCP Server Entry Point
 *
 * This script starts the MCP (Model Context Protocol) server that AI agents
 * connect to. It initializes Magento's ObjectManager and exposes tools for
 * introspection, code generation, and Magento-specific operations.
 *
 * The server communicates via stdio (stdin/stdout) using JSON-RPC 2.0.
 */

declare(strict_types=1);

// Prevent direct web access
if (PHP_SAPI !== 'cli' && PHP_SAPI !== 'phpdbg') {
    echo 'This script must be run from the command line.' . PHP_EOL;
    exit(1);
}

// Find and load Composer autoloader
$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',      // Development (running from package root)
    __DIR__ . '/../../../autoload.php',        // Installed as dependency (vendor/inchoo/magento-bricklayer/bin)
    __DIR__ . '/../../../../vendor/autoload.php', // Alternative path
];

$autoloader = null;
foreach ($autoloadPaths as $path) {
    if (file_exists($path)) {
        $autoloader = require $path;
        break;
    }
}

if ($autoloader === null) {
    // Output error as JSON-RPC error response
    $error = [
        'jsonrpc' => '2.0',
        'id' => null,
        'error' => [
            'code' => -32603,
            'message' => 'Composer autoloader not found. Please run composer install.',
        ],
    ];
    fwrite(STDOUT, json_encode($error) . "\n");
    exit(1);
}

// Disable output buffering for real-time communication
while (ob_get_level()) {
    ob_end_clean();
}

// Handle signals for graceful shutdown
if (extension_loaded('pcntl')) {
    pcntl_async_signals(true);
    pcntl_signal(SIGINT, function () {
        exit(0);
    });
    pcntl_signal(SIGTERM, function () {
        exit(0);
    });
    pcntl_signal(SIGPIPE, SIG_IGN);
}

use Inchoo\MagentoBricklayer\Mcp\McpServerFactory;
use Mcp\Server\Transport\StdioTransport;
use Psr\Log\AbstractLogger;

// Create a simple stderr logger
$logger = new class extends AbstractLogger {
    public function log($level, string|\Stringable $message, array $context = []): void
    {
        // Only log errors and above to stderr to avoid polluting MCP communication
        if (in_array($level, ['error', 'critical', 'alert', 'emergency'])) {
            fwrite(STDERR, sprintf("[%s] %s\n", strtoupper((string)$level), $message));
        }
    }
};

// Set exception handler to log uncaught exceptions
set_exception_handler(function (\Throwable $e) use ($logger): void {
    $logger->critical('Uncaught exception: ' . $e->getMessage(), [
        'exception' => $e,
        'file' => $e->getFile(),
        'line' => $e->getLine(),
    ]);
    exit(1);
});

// Run the MCP server
try {
    $factory = new McpServerFactory();
    $server = $factory->create($logger);

    $transport = new StdioTransport(logger: $logger);
    $result = $server->run($transport);

    exit($result);
} catch (\Throwable $e) {
    $logger->critical('Server initialization failed: ' . $e->getMessage());
    exit(1);
}
